# apps/api 를 docker 없이 직접 실행할 때(uvicorn) 읽는 값. 없으면 기본값(SQLite)을 쓴다.
APP_NAME=가비 API
DEBUG=false
DATABASE_URL=sqlite:///./data/gabee.db
DATA_DIR=./data
CORS_ORIGINS=*
ANTHROPIC_API_KEY=
# 로컬 언어 모델(Ollama) — 파일 자동 분류에 쓴다. 글자는 외부로 나가지 않는다
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen2.5:7b
# TypeSafe Jev — 키가 있으면 파일 자동 분류에 쓴다(가린 글자만 보냄). 없으면 로컬 언어 모델
TYPESAFE_API_KEY=
# 얼굴 찾기 모델 폴더(비우면 DATA_DIR/models/faces). 모델이 없으면 얼굴 찾기를 건너뛴다
FACE_MODEL_DIR=
