# apps/api 를 docker 없이 직접 실행할 때(uvicorn) 읽는 값. 없으면 기본값(SQLite)을 쓴다.
APP_NAME=가비 API
DEBUG=false
DATABASE_URL=sqlite:///./data/gabee.db
# 데이터 폴더: 프로필 사진은 DATA_DIR/profile_photos/ 에 저장된다(운영에서는 볼륨에 둔다)
DATA_DIR=./data
CORS_ORIGINS=*
ANTHROPIC_API_KEY=
# Anthropic 모델 선택(예: claude-sonnet-5-5). 비우면 기본값 claude-haiku-5-5. 예전 이름 LLM_MODEL 도 읽는다
# ANTHROPIC_MODEL=

# 팀 공용 PostgreSQL(README.md "팀 공용 PostgreSQL 에 연결하기" 참고) 연결 예시 — 아래 두 줄은
# 주석 처리된 예시일 뿐이다. 실제로 쓸 때는 이 파일(.env.example)이 아니라 git에 올라가지
# 않는 실제 .env 파일에만 비밀번호를 채워 넣고, PowerShell 명령 라인에는 절대 직접 입력하지 않는다.
#
# 일반 실행(gabee_app 계정, DDL 권한 없음):
# DATABASE_URL=postgresql+psycopg://gabee_app:<비밀번호>@192.168.0.44:5432/gabee
#
# gabee_migrator 계정은 개발자 .env 에 넣지 않는다. 개발·마이그레이션 작성은 각자 로컬 DB 에서 하고, 공용 DB 마이그레이션은
# main 병합 뒤 통합 때 DB 담당자가 공용 DB PC 의 Pull Agent 를 수동 실행해 그 PC 의 pgpass 로만 반영한다
# (README.md "팀 공용 PostgreSQL 에 연결하기", docs/adr/0009-local-first-db-workflow.md).

# 로그인 JWT 비밀키: 32자 이상 무작위 값. 비우면 로컬 SQLite/DEBUG=true 에서만 임시 키(재시작 시 로그인 풀림)를 쓰고,
# PostgreSQL(공용·운영)에서는 로그인이 503(auth_not_configured)이다 — 공용 DB 로 개발하면 값을 두거나 DEBUG=true.
# python -c "import secrets;print(secrets.token_urlsafe(48))"
# JWT_SECRET=
# 레거시 X-Gyeot-Token(익명 계정) 인증 허용(기본 true — 모바일 전환이 끝나면 false)
# ALLOW_LEGACY_TOKEN_AUTH=true
# ACCESS_TOKEN_TTL_SECONDS=900  # 로그아웃 후에도 Access Token 은 만료까지 유효하다
# REFRESH_TOKEN_TTL_SECONDS=2592000
# 로그인 실패 제한(프로세스 메모리): 프록시 뒤에서 uvicorn --proxy-headers 없이 쓰면 IP 제한을 끈다
# LOGIN_MAX_FAILURES_PER_IP=50   # 0 = 끔

# 이메일 인증·비밀번호 재설정 메일. 기본은 꺼짐(관련 API 는 503 mail_not_configured, 발송 성공으로 처리하지 않는다).
# 개발: MAIL_BACKEND=console 이면 메일 내용(토큰 링크 포함)을 서버 로그에 출력한다(로컬 SQLite/DEBUG=true 에서만 동작).
# 실제 발송: MAIL_BACKEND=smtp 와 아래 SMTP_* — 비밀번호는 이 파일이 아니라 git 에 올라가지 않는 .env 에만 둔다.
# MAIL_BACKEND=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_SECURITY=starttls   # starttls | ssl | none
# SUPPORT_EMAIL=   # 공개 안내 페이지(개인정보처리방침·약관)에 보이는 문의 이메일. 비우면 이메일 줄이 보이지 않는다
# EMAIL_LINK_BASE=gabee://   # 메일 링크의 앱 주소(딥링크 또는 웹 주소): <base>verify-email?token=..., <base>reset-password?token=... (웹에서 눌러 보려면 http://localhost:8081/ 처럼 웹 앱 주소)
# EMAIL_VERIFY_TTL_SECONDS=180   # 인증번호(6자리)·링크 유효 시간. 기본 3분
# PASSWORD_RESET_TTL_SECONDS=1800
# CODE_MAX_ATTEMPTS=5   # 6자리 코드(메일 1통)마다 틀려도 되는 횟수. 넘으면 메일을 다시 받아야 한다
# REQUIRE_EMAIL_VERIFICATION=false   # 기본 false: 이메일이 없거나 인증하지 않아도 가족에 참여할 수 있다. true 로 켜면 이메일을 적고 미인증인 회원의 그룹 생성·참여를 막는다(메일 발송이 설정된 환경에서만, 이메일 없는 계정은 막지 않음)
# REQUIRE_TESTER_CONSENT=false   # 기본 false. true 로 켜면 테스트 동의서(TESTER_CONSENT_VERSION, 앱의 CONSENT_VERSION 과 같게)에 동의하지 않은 정식 회원의 API 요청을 403(tester_consent_required)으로 막는다. 내 정보·동의 저장은 열려 있다
# 통합관리자 허용 목록: 쉼표로 구분한 사용자 id. 비우면 아무도 허용하지 않는다(fail-closed). 서비스 관리·운영 관리를 함께 연다.
# 실제 id 는 .env·비밀 관리에만 두고 Git·문서에 넣지 않는다. (예전 OPS_ADMIN_USER_IDS·SERVICE_ADMIN_USER_IDS 는 더 읽지 않는다)
# ADMIN_USER_IDS=
# 관리자 챗봇 실행 기록을 LangSmith 로 보낸다(기본 false). 이 챗봇에만 적용되고 LANGSMITH_TRACING 같은 서버 전체 추적은 넣지 않는다.
# 켜면 가린 질문·답 규칙·도구 숫자·답이 LangSmith 에 저장된다. 키는 .env 에만 둔다.
# ADMIN_LANGSMITH_ENABLED=false
# ADMIN_LANGSMITH_API_KEY=
# ADMIN_LANGSMITH_PROJECT=gabee-admin-chatbot
# 관리자 챗봇을 메인 + 담당(서비스·운영·규칙 서브 에이전트) 구조로 돌린다(기본 false). 켜면 질문 하나에 Claude 호출이 최대 8번까지 는다(기존 4번).
# ADMIN_CHATBOT_SUBAGENTS=false
# SUBSCRIPTION_API_ENABLED=false   # 기본 false: 구독·통신비 서버 API(/billing/subscriptions*)를 닫는다(지갑 탭에서 구독 기능을 뺌). 요청은 403(subscription_disabled)이고 일정 추천도 구독 결제일을 읽지 않는다. 테이블·데이터는 그대로다. true 로 켜면 다시 쓴다
# VERIFY_RESEND_COOLDOWN_SECONDS=60
# VERIFY_MAX_PER_HOUR=5
# RESET_MAX_PER_EMAIL_PER_HOUR=3
# RESET_MAX_PER_IP_PER_HOUR=20   # 0 = IP 제한 끔(프록시 뒤)

# 가족 초대(정식 회원이 만들거나 재발급하는 코드): 기본 24시간·1회. 틀린 코드를 입력한 실패가 15분 안에 5회면 계정별·IP별로 막는다
# INVITE_TTL_SECONDS=86400
# SETTLEMENT_REMIND_HOURS=24
# INVITE_MAX_USES=1
# INVITE_MAX_FAILURES=5
# INVITE_FAILURE_WINDOW_SECONDS=900

# DB 스키마 준비 상태 재점검 주기(초, 선택). 기본값이면 충분하다 — 준비 안 됨 상태(마이그레이션 진행 중)에서는 자주 다시 확인한다
# SCHEMA_RECHECK_READY_SECONDS=30
# SCHEMA_RECHECK_NOT_READY_SECONDS=2
# TypeSafe Jev — 키가 있으면 로컬 분류기가 확신하지 못한 문서를 분류한다(가린 글자만 보냄). 없으면 "확인 필요"로 저장한다
TYPESAFE_API_KEY=
# 원본 파일(가리기 전)을 그대로 보관하는 폴더(비우면 DATA_DIR/raw). 없으면 서버가 만든다. 서버만 읽을 수 있게 둔다
RAW_DIR=
# 채팅(외부 Claude)이 근거로 읽을 수 있는 기록에 민감 기록(처방전·신분증 등)을 넣을지(기본 true, 가린 글만 보낸다)
CHAT_INCLUDE_SENSITIVE=true
# 업로드 파일의 글자 읽기(OCR)·개인정보 가리기를 Claude 로 할지(기본 false). 켜면 파일 내용이 Anthropic API 로 전송된다(docs/adr/0014). 호출이 실패하면 가리지 않은 글은 저장하지 않고 파일을 failed 로 둔다
# 글자 읽기와 가리기는 항상 Claude 로 한다(기본 true, ANTHROPIC_API_KEY 필요). 끄지 않는다
# INGEST_LLM_OCR=true
# INGEST_LLM_MASK=true
# INGEST_OCR_MODEL=claude-sonnet-5-5
# INGEST_MASK_MODEL=        # 비우면 ANTHROPIC_MODEL
# INGEST_MASK_CHUNK_CHARS=6000
# 로컬 OCR(RapidOCR)은 서비스에서 제거했다(docs/adr/0025): 사진·스캔 PDF 의 글자는 Claude 로만 읽으므로 서비스에서는 INGEST_LLM_OCR=true 가 필요하다.
# 가족방 사진 판별을 로컬 SigLIP2 단독으로 한다(margin > 5 이면 document, 아니면 unsure, 외부로 보내지 않는다). 기본 false: 꺼져 있으면 모든 사진이 unsure 가 되어 문서 자동 등록이 멈춘다.
# 모델 폴더(siglip2_vision.onnx + head.json, 저장소에 없음)를 PHOTO_CLASSIFY_MODEL_DIR 에 적는다(Docker 이미지는 data/models/siglip2-onnx 가 있으면 자동 설정). 없으면 사진 판별이 failed 가 된다
# (예전 Claude 사진 판별 PHOTO_JUDGE_LLM·PHOTO_JUDGE_MODEL 은 지웠다)
# PHOTO_CLASSIFY_SIGLIP=false
# PHOTO_CLASSIFY_MODEL_DIR=
# PHOTO_CLASSIFY_THREADS=2
# 날짜별 가족 타임라인의 자동 후보·같은 날 유사 사진 묶기(이미지 임베딩). 기본 false(꺼짐: 확인·직접 포함 사진만, 이미지 분석 없음).
# 켜도 ADR 0020 조건(FAMILY_MEMORY_ENABLED·가족 활성화·업로더 동의)을 만족한 사진만 분석한다. 운영에서 켜는 것은 별도 승인(docs/adr/0026)
# TIMELINE_AUTO_CANDIDATES=false
# AI 추억 분석 서버 스위치(기본 꺼짐, ADR 0020). 꺼져 있으면 가족 설정·업로더 동의를 새로 받지 않고 어떤 사진도 분석 자격이 없다. 켜기 전에 개인정보 고지(T31)가 먼저 필요하다
# FAMILY_MEMORY_ENABLED=false
# AI 추억 분석 작업 워커(PR3, 단일 경량 스레드, 기본 꺼짐). FAMILY_MEMORY_ENABLED 와 이 값이 둘 다 켜져 있을 때만 서버가 시작하며 돌린다. 이미지 분석 처리 함수는 아직 없다(PR4)
# FAMILY_MEMORY_WORKER_ENABLED=false
# FAMILY_MEMORY_WORKER_POLL_SECONDS=5       # 일이 없을 때 다음 확인까지 기다리는 시간
# FAMILY_MEMORY_JOB_LEASE_SECONDS=300       # 선점한 작업의 임대 시간(넘기면 되찾아 재시도)
# AI 추억 이미지 임베딩 인코더(PR4, 기본 off): siglip2 = 이미 내려받은 로컬 SigLIP2 파일만(다운로드 안 함), fake = 개발·시험용. 모델은 웹 서버가 아니라 별도 워커 프로세스
# (`python -m app.features.family_memory.worker_main`, torch·transformers 가 있는 환경)에서만 올라간다. 자동 등록은 없다(큐에 들어 있는 작업만 처리)
# FAMILY_MEMORY_ENCODER=off
# FAMILY_MEMORY_SIGLIP2_PATH=          # 모델 스냅샷 폴더(로컬 경로)
# FAMILY_MEMORY_ENCODER_DEVICE=auto    # auto | cpu | cuda
# FAMILY_MEMORY_ENCODER_FP16=false     # GPU 에서 반 정밀도(메모리 약 절반)
# 추억 후보 조회 API(`GET /family-memory/candidates`, PR6) 미출시 가드(기본 꺼짐: 꺼져 있으면 404). 후보는 비공개이며 자동 게시하지 않는다. 앱(PR7) 개발·검증 때만 켠다
# FAMILY_MEMORY_CANDIDATES_API_ENABLED=false
# 동의할 때 consent_version 을 반드시 보내야 하게 한다(T31 고지문 확정 뒤 켠다, 기본 꺼짐: 켜면 버전을 안 보낸 동의는 409)
# FAMILY_MEMORY_CONSENT_VERSION_REQUIRED=false
# 사용자 요청형 추억 생성 입구(실제 가족 사진을 처리하는 입구). T31 고지문·동의 UX 와 별도 출시 승인 전에는 켜지 않는다(기본 꺼짐, 꺼지면 404). 켜져 있어도 위 CONSENT_VERSION_REQUIRED 가 함께 켜져 있어야 열린다
# FAMILY_MEMORY_GENERATE_ENABLED=false
# FAMILY_MEMORY_GENERATE_MAX_PHOTOS=300
# INGEST_PDF_MAX_PAGES=20
# INGEST_RETRY_MAX=2             # Claude 연결 실패로 failed 가 될 파일을 자동으로 다시 처리하는 횟수(0이면 안 함)
# INGEST_REMINDERS=false          # 올린 문서의 날짜에서 챙길 일을 뽑는다(켜면 파일마다 Claude 1회 더)
# INGEST_RETRY_WAIT_SECONDS=20   # 다시 처리하기 전 기다리는 초(n번째 재시도는 n배)
# AI 채팅 탭의 웹 검색(기본 false). 켜면 검색어가 Anthropic 웹 검색으로 나가고 검색 1,000회에 10달러가 더 든다
# WEB_SEARCH_ENABLED=false
# WEB_SEARCH_MAX_USES=3          # 질문 하나에 검색할 수 있는 횟수
# 정산·돌봄·가족 채팅 에이전트의 답을 메인이 다시 모델로 다듬지 않고 그대로 돌려줄지(기본 true, 질문당 모델 호출 1번 절약). 끄면 false
# ASSISTANT_DIRECT_AGENT_REPLY=true

# Google·Kakao 로그인(PR 4-D). 비어 있으면 그 제공자 로그인은 503(social_not_configured). 앱 키는 이 파일이 아니라 .env 에만 둔다.
# GOOGLE_CLIENT_IDS=   # 앱이 ID 토큰을 받을 때 쓴 Google OAuth 클라이언트 ID(웹/iOS/Android, 여러 개면 쉼표로). Firebase 로그인 토큰은 받지 않는다
# KAKAO_APP_ID=        # Kakao 개발자 콘솔의 앱 ID(숫자)
# SOCIAL_HTTP_TIMEOUT_SECONDS=5
# 가족 채팅 AI(분석·답장·주제 추천): 구성원이 누르거나 가족 소유자·관리자가 동의했을 때만 Anthropic 을 부른다. 일반 메시지 전송은 AI 를 부르지 않는다.
# 한 번에 보내는 응답 토큰 상한(기본 2048)
# ANTHROPIC_MAX_TOKENS=2048
# Agent 및 Agent 관련 분석의 최대 출력 토큰 상한
AGENT_MAX_OUTPUT_TOKENS=10000
# 자동 분석(기본 꺼짐, 아직 구현하지 않은 설계 — 켜도 메시지마다 부르지 않는다)
# AI 추론 강도(low|medium|high). 낮을수록 출력 토큰이 적게 든다(기본 low)
# AI_EFFORT=low
# AI_AUTO_ANALYSIS_ENABLED=false
# 사용자별 하루 AI 호출 수(캐시 적중은 세지 않는다). 넘으면 429 ai_daily_limit_user
# AI_MAX_CALLS_PER_USER_PER_DAY=10
# 가족 그룹별 하루 AI 호출 수. 넘으면 429 ai_daily_limit_group
# AI_MAX_CALLS_PER_GROUP_PER_DAY=30
# 정산·돌봄 탭 에이전트(질문 1번 = 1회로 셈. 기본 한도·일정 에이전트와 따로 센다)
# AI_TAB_AGENT_COOLDOWN_SECONDS=0
# AI_TAB_AGENT_MAX_CALLS_PER_USER_PER_DAY=60
# AI_TAB_AGENT_MAX_CALLS_PER_GROUP_PER_DAY=200
# 같은 사용자의 AI 호출 사이 최소 간격(초). 안이면 429 ai_cooldown 과 Retry-After
# AI_REQUEST_COOLDOWN_SECONDS=30
# AI 어시스턴트(채팅·기록 질문)는 위 기본 한도와 따로 센다. 질문 1건이 도구 루프로 1~4번 부르고 모두 센다
# 사용자별 하루 호출 수(기본 100, 예전 값). 넘으면 429 ai_daily_limit_user
# AI_ASSISTANT_MAX_CALLS_PER_USER_PER_DAY=100
# 가족 그룹별 하루 호출 수(기본 300, 새 상한). 넘으면 429 ai_daily_limit_group
# AI_ASSISTANT_MAX_CALLS_PER_GROUP_PER_DAY=300
# 어시스턴트 호출 사이 최소 간격(초, 기본 0 = 없음). 안이면 429 ai_cooldown
# AI_ASSISTANT_COOLDOWN_SECONDS=0
# 같은 요청의 결과를 다시 쓰는 시간(초, 가족 그룹별로 따로 보관). 0 이면 캐시 끔
# AI_RESULT_CACHE_TTL_SECONDS=600
# 한 가족 그룹에서 동시에 진행할 수 있는 AI 호출 수. 넘으면 409 ai_busy
# AI_MAX_CONCURRENT_REQUESTS_PER_GROUP=1
# 임시 경로 스위치: 쉼표로 구분한 `METHOD /path`(경로에 * 허용) 요청을 503 route_disabled 로 끈다. 비우면 끄는 경로 없음. 예: POST /ai-assistant/knowledge/items
DISABLED_AI_ROUTES=
# 가명화 NER 보강(이름·주소, KoELECTRA-small ONNX). 모델 파일은 Git 에 없고 서버 폴더에 복사한다(시크릿 아님)
# off: 안 씀 / auto: 모델이 있고 로드되면 사용, 없거나 실패하면 규칙만(경고 로그 한 번) / required: 못 쓰면 503 privacy_unavailable(fail-closed)
# 권장: 운영 required, 개발 auto. 서버 시작 때 백그라운드로 미리 불러오고, 로드 때 model_card.json 의 sha256 으로 파일 무결성을 확인한다
# PRIVACY_NER_MODE=auto
# 모델 폴더(model.onnx, tokenizer.json, labels.json, model_card.json). 비우면 DATA_DIR/models/ner. 교체·롤백 절차는 docs/security/PRIVACY_PIPELINE_MODULE.md
# PRIVACY_NER_MODEL_DIR=
# onnxruntime CPU 스레드 수(추론 하나당)
# PRIVACY_NER_THREADS=2
# 동시에 도는 추론 수. 넘으면 대기하고 오래 걸리면 auto 는 규칙만·required 는 503
# PRIVACY_NER_MAX_CONCURRENCY=2
# 폴더 안 모델 파일(양자화 모델은 model.int8.onnx)
# PRIVACY_NER_MODEL_FILE=model.onnx
# 운영 관리자 요청 지표: 기본 꺼짐. 켜면 요청마다 X-Trace-Id 를 내려주고 메서드·경로 패턴·상태코드 구분·지연 시간만 집계한다.
# 구간(초)과 보관 일수는 초기값이며 실제 트래픽을 본 뒤 조정한다. 공용 DB 에 ops_request_metrics 가 생긴 뒤에 켠다.
# OPS_METRICS_ENABLED=false
# OPS_METRICS_BUCKET_SECONDS=300
# OPS_METRICS_RETENTION_DAYS=90
# 운영 관리자 오류 이벤트: 기본 꺼짐. 켜면 5xx·처리되지 않은 예외·401/403 을 지문별로 합쳐 저장한다(가린 메시지 200자, 사용자·가족 id 없음).
# 공용 DB 에 ops_error_events 가 생긴 뒤에 켠다. 보관 일수는 요청 지표와 같은 초기값이다.
# OPS_ERRORS_ENABLED=false
# OPS_ERRORS_RETENTION_DAYS=90
# 인프라 상태(Cloud Run 에서만 동작, 서비스 계정에 roles/run.viewer·roles/monitoring.viewer 필요)
# OPS_INFRA_ENABLED=false
# 관리자 AI 초안: 알림 점검 뒤 Claude 가 공지 초안·문의 답변 초안을 만들어 대기함에 둔다(앱에는 관리자가 저장해야 올라간다). 문의 글은 가린 뒤 보낸다
# ADMIN_DRAFTS_ENABLED=false
# 긴급 서버 장애 자동 공지: 서버 오류율 '긴급' 알림이 생기면 정해 둔 문구(AI 아님)로 공지를 바로 올린다(6시간에 한 번)
# AUTO_NOTICE_ENABLED=false
# 폰 푸시: 기본 꺼짐. 켜면 알림함 알림을 저장한 뒤(커밋 후) Expo 푸시 서비스로 발송한다.
# 푸시 토큰이 없거나 발송이 실패해도 원래 기능에는 영향이 없다. 안드로이드 FCM 키는 EAS 에 올리며 서버에는 두지 않는다.
# PUSH_ENABLED=false
# Expo 계정에서 '푸시 보안'(Enhanced Security)을 켠 경우에만 Expo 액세스 토큰을 넣는다.
# PUSH_EXPO_ACCESS_TOKEN=
# 메타 광고 성과(관리자 › 데이터 분석, 읽기 전용): 비우면 "설정 전"만 보인다.
# 토큰: 메타 비즈니스 설정 › 사용자 › 시스템 사용자 › 토큰 생성(권한 ads_read). 광고 계정 번호: 광고 관리자 주소의 act= 숫자.
# META_ADS_ACCESS_TOKEN=
# META_ADS_ACCOUNT_ID=
# META_ADS_API_VERSION=v25.0
# 찰칵 흔한 사진 자동 보충: 기본 꺼짐. 켜면 가족이 찰칵 추천을 열 때 오늘 부족분이 있으면 백그라운드로
# Pixabay 사진 + AI 질문으로 흔한 사진을 목표 장수까지 채운다. PIXABAY_API_KEY·ANTHROPIC_API_KEY 가 있어야 한다.
# PHOTO_REC_AUTO_ENABLED=false
# PIXABAY_API_KEY=
# PHOTO_REC_AUTO_PER_DAY=3
# PHOTO_REC_AUTO_MAX_ATTEMPTS=3
# PHOTO_REC_AUTO_COOLDOWN_SECONDS=600
