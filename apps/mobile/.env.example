EXPO_PUBLIC_API_URL=
# 로그인 화면이 붙기 전까지 쓰는 개발용 토큰(가입 응답의 token). 비워 두면 토큰 없이 요청한다.
EXPO_PUBLIC_DEV_TOKEN=
# 개발용: 월말 정산 알림을 확인할 때 오늘 날짜를 바꾼다(YYYY-MM-DD). 비우면 실제 오늘.
EXPO_PUBLIC_DEV_TODAY=
# 개발용: 돌봄의 다가오는 일정·누락을 확인할 때 '지금' 시각을 바꾼다(HH:MM). 비우면 실제 시각.
EXPO_PUBLIC_DEV_NOW=
# Google·카카오 로그인(공개 값). 비어 있으면 그 로그인 버튼은 보이지 않는다. 비밀값(앱 시크릿)은 앱이 아니라 서버 .env 에만 둔다.
# Google: OAuth 클라이언트 ID(웹/iOS/Android). 서버의 GOOGLE_CLIENT_IDS 에도 같은 값을 넣어야 로그인이 통과한다.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# 카카오: REST API 키. 서버의 KAKAO_APP_ID(앱 ID)와 같은 앱이어야 한다. 카카오 콘솔 Redirect URI 에는 https://<서버>/auth/kakao/callback (모바일, 서버가 앱으로 넘겨 줌)과 http://localhost:8086/kakao (웹 시험)를 등록한다.
EXPO_PUBLIC_KAKAO_REST_API_KEY=
# 가족 초대 페이지(apps/invite-page) 공개 주소. 있으면 초대 링크가 카카오톡·SNS 에서 눌리는 https 링크가 되고,
# 비우면 앱을 바로 여는 주소(gabee://family-join?code=…)를 보낸다. 예: https://<계정>.github.io/gabee-invite
EXPO_PUBLIC_INVITE_PAGE_URL=
# 가족 추억 후보 화면 진입점(개발·시험 전용, 기본 off): off | on(실제 API, 서버의 FAMILY_MEMORY_CANDIDATES_API_ENABLED 가 켜진 개발 서버에서만) | mock(합성 데이터)
EXPO_PUBLIC_FAMILY_MEMORY_UI=
