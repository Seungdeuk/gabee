# docker compose 가 읽는 값 (실제 값은 .env 에 두고 git 에 올리지 않는다)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gabee
# 선택: 호스트에 이미 5432 를 쓰는 PostgreSQL이 있다면 다른 포트로 바꾼다
POSTGRES_PORT=5432

# 선택
CORS_ORIGINS=*
ANTHROPIC_API_KEY=

# 관리자 알림: 기본 꺼짐. 점검 주소를 부르는 스케줄러와 같은 토큰을 서버 환경변수로만 둔다(실제 값은 여기 적지 않는다)
# ADMIN_ALERTS_ENABLED=false
# ADMIN_ALERTS_TOKEN=
